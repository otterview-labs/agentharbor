{
  "name": "@otterview-labs/agentharbor",
  "version": "0.2.0-alpha.3",
  "description": "Local multi-agent missions with persistent execution, verification and independent review",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentharbor": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "doctor": "npm run build && node dist/src/cli.js doctor",
    "start": "node dist/src/cli.js",
    "check:desktop": "tsc -p apps/desktop/tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && node scripts/start-desktop.mjs",
    "preview:desktop": "vite preview --config apps/desktop/vite.config.ts",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "test:desktop": "playwright test --config apps/desktop/playwright.config.ts",
    "test:package": "node scripts/test-desktop-package.mjs"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "^1.0.8",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.10.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "dist-electron/main.cjs",
  "author": "AgentHarbor contributors",
  "homepage": "https://github.com/otterview-labs/agentharbor",
  "overrides": {
    "@electron/asar": {
      "minimatch": "^11.0.4",
      "glob": "^14.0.3"
    }
  }
}
